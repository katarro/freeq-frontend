# Modo de la aplicación (development | production)
NEXT_PUBLIC_MODE=development

# URLs de la API para cada entorno
NEXT_PUBLIC_API_URL_DEVELOP=http://localhost:3001/api
NEXT_PUBLIC_API_URL_PRODUCTION=https://tudominio.com/api

# Clave de encriptación para datos sensibles (mínimo 32 caracteres)
# IMPORTANTE: Genera una clave única y segura para producción
NEXT_PUBLIC_ENCRYPTION_KEY=genera-una-clave-unica-de-32-caracteres-minimo

# ========================================
# CONFIGURACIÓN DE COOKIES (OPCIONAL)
# ========================================

# Para desarrollo
NEXT_PUBLIC_COOKIE_DOMAIN_DEVELOP=localhost
NEXT_PUBLIC_COOKIE_SECURE_DEVELOP=false

# Para producción  
NEXT_PUBLIC_COOKIE_DOMAIN_PRODUCTION=tudominio.com
NEXT_PUBLIC_COOKIE_SECURE_PRODUCTION=true

